# Firebase is configured in src/firebase.js (hardcoded for deploy simplicity).
# No VITE_FIREBASE_* variables are required for the leaderboard.

# One-time purge (recommended): RTDB `remove()` on `leaderboard` + `global_top_runs` + `scores`.
# First launch with this set runs the wipe once per browser, logs: Leaderboard database has been fully cleared
# Then REMOVE this line and rebuild — boot code no longer enters the purge branch.
# Need another wave later? Change the value (e.g. wipe-v2) and ship once, then remove again.
# VITE_LEADERBOARD_ONE_TIME_PURGE=wipe-v1

# Brute wipe: runs on EVERY app load while true (no localStorage gate). Use briefly, then unset.
# VITE_CLEAR_LEADERBOARD_ON_BOOT=true
