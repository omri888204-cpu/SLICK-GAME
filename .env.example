# Firebase is configured in src/firebase.js (hardcoded for deploy simplicity).
# No VITE_FIREBASE_* variables are required for the leaderboard.

# Sentinel purge — runs every startup while non-empty (Firestore batch delete): leaderboard + global_top_runs + scores.
# Console confirmation: Leaderboard database has been fully cleared
# Remove this line and redeploy immediately after validating (otherwise every reload wipes scores again).
# VITE_LEADERBOARD_ONE_TIME_PURGE=wipe-YYYY-MM-DD

# Same wipe triggers on every startup until unset (omit sentinel when using this simpler flag).
# VITE_CLEAR_LEADERBOARD_ON_BOOT=true
