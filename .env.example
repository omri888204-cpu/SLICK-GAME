# Firebase is configured in src/firebase.js (hardcoded for deploy simplicity).
# No VITE_FIREBASE_* variables are required for the leaderboard.

# One-time wipe of Firestore collections `leaderboard` + `global_top_runs` when the app loads.
# Set to true, run the game once (wait for console: cleared leaderboard collections), then remove or set false.
# VITE_CLEAR_LEADERBOARD_ON_BOOT=true

# One-time wipe of Firestore collections `leaderboard` + `global_top_runs` when the app loads.
# Set to true, run the game once (wait for console: cleared leaderboard collections), then remove or set false.
# VITE_CLEAR_LEADERBOARD_ON_BOOT=true
